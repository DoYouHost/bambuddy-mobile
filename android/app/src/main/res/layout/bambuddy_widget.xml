<?xml version="1.0" encoding="utf-8"?>
<!-- Widget bambuddy (zmienny rozmiar, min 2x2). Układ wierszowy:
       1. kropka + nazwa drukarki + status (+ skaner)
       2. miniatura okładki + nazwa wydruku
       3. ETA (czas + godzina) + warstwy
       4. pasek postępu (pełna szerokość) + procent
     Miniatura (wiersz 2) pokazywana tylko, gdy widget dość szeroki — patrz
     BambuddyWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Wiersz 1: kropka statusu + nazwa drukarki + status + przycisk skanera. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/widget_status_dot"
            android:contentDescription="@null" />

        <!-- Nazwa (z wagą, zwija się wielokropkiem) + chip statusu. Chip to
             zwykłe TŁO TextView (background) — renderuje się zawsze i otacza
             tekst z paddingiem. Kolor (obrys+wypełnienie) ustawiany w kodzie
             przez setBackgroundResource per status (widget_chip_*). -->
        <TextView
            android:id="@+id/widget_printer_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.01"
            android:text="BambuBuddy" />

        <TextView
            android:id="@+id/widget_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_chip_offline"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:letterSpacing="0.02"
            android:text="" />

        <ImageButton
            android:id="@+id/widget_scan_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/widget_scan_button_bg"
            android:src="@drawable/widget_ic_scan"
            android:contentDescription="@string/widget_scan" />
    </LinearLayout>

    <!-- Linia-akcent pod nagłówkiem, barwiona kolorem statusu w kodzie
         (setBackgroundColor). Wizualnie oddziela nagłówek i komunikuje stan.
         ImageView, bo RemoteViews nie obsługuje <View>/<Space>. -->
    <ImageView
        android:id="@+id/widget_accent_line"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Wiersz 2: miniatura okładki + nazwa wydruku. Cały wiersz GONE bez druku.
         Bierze CAŁĄ wolną przestrzeń (weight=1) — nagłówek, meta i pasek postępu
         (wrap_content) rezerwują swoje miejsce pierwsze, więc nigdy nie znikają.
         Miniatura wypełnia wysokość wiersza (match_parent + adjustViewBounds),
         skalując się do proporcji okładki — w pełni dynamicznie, bez liczenia dp
         w kodzie, więc dopasuje się do każdego rozmiaru/DPI/launchera. -->
    <LinearLayout
        android:id="@+id/widget_file_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:adjustViewBounds="true"
            android:maxWidth="200dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_print_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:ellipsize="end"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="15sp"
            android:text="" />
    </LinearLayout>

    <!-- Pełna treść błędu HMS (zawija się) — pokazywana zamiast podglądu/żartu,
         gdy status = error. Chip w nagłówku niesie tylko krótką etykietę „Błąd",
         bo pełne zdanie nie mieści się w odznace. Ten sam centralny pas (weight=1)
         co wiersz pliku i żart — naraz widoczny tylko jeden. -->
    <TextView
        android:id="@+id/widget_error_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:maxLines="4"
        android:ellipsize="end"
        android:textStyle="bold"
        android:textSize="15sp"
        android:visibility="gone"
        android:text="" />

    <!-- Żartobliwy tekst zamiast podglądu, gdy drukarka idle/offline. Zajmuje ten
         sam centralny pas (weight=1) co wiersz pliku — naraz widoczny jest tylko
         jeden (drugi GONE), więc waga działa poprawnie. -->
    <TextView
        android:id="@+id/widget_quip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/widget_text_secondary"
        android:textStyle="italic"
        android:textSize="15sp"
        android:visibility="gone"
        android:text="" />

    <!-- Wiersz 3: ETA (czas + godzina końca) + warstwy. Człony ukrywane osobno.
         Przyklejony do paska postępu (mały odstęp). -->
    <LinearLayout
        android:id="@+id/widget_meta_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_eta_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_ic_clock"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_eta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:text="" />

        <ImageView
            android:id="@+id/widget_layers_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/widget_ic_layers"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_layers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:text="" />
    </LinearLayout>

    <!-- Wiersz 4: pasek postępu (pełna szerokość) + procent. Dosunięty do dołu. -->
    <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/widget_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="36dp"
            android:gravity="end"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="0%" />
    </LinearLayout>
</LinearLayout>
