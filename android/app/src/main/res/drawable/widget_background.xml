<?xml version="1.0" encoding="utf-8"?>
<!-- Tło karty widgetu: bazowy diagonalny gradient + miękki radialny blask w
     lewym-górnym rogu (imituje źródło światła → głębia) + delikatna obwódka. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/widget_bg_top"
                android:endColor="@color/widget_bg_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_bg_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="-0.05"
                android:gradientRadius="85%p"
                android:startColor="@color/widget_bg_glow"
                android:endColor="#006AAEEA" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
