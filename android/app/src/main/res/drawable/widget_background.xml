<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card background (design 2026-07): near-black base + soft greenish
     radial glow in the top-left corner (fakes a light source) + subtle outline.
     Mirrors radial-gradient(130% 130% at 15% 0%, #131a12 → #050605). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg_bottom" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_bg_stroke" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0.0"
                android:gradientRadius="115%p"
                android:startColor="@color/widget_bg_glow"
                android:endColor="#00131A12" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
