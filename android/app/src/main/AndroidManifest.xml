<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Saving a print's timelapse to the gallery. Android 11 (API 30) and up
         need nothing: MediaStore lets an app write its own entries. Below that
         — and this flavor still supports API 24 — writing into an album is a
         storage write, which is what `gal` checks for (hasAccess(toAlbum) is
         false for SDK 23..29), so the video would silently fail to save.
         maxSdkVersion keeps the request off every device that does not need
         it; the app asks for it at the moment of the first save, not at
         startup. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <!-- Ongoing print notification + background alerts (Android 13+ needs the
         runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- The foreground service keeps the process alive in the background so the
         WebSocket keeps receiving statuses and updating the print notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- `connectedDevice`, not `dataSync`: from targetSdk 35 on a dataSync
         service is allowed 6 hours in a day and the counter resets only when
         the user brings the app to the foreground, so a long print loses its
         monitor half way through and nothing tells the user. connectedDevice
         has no timeout. CHANGE_NETWORK_STATE is what qualifies the app for that
         type over a network link — the type takes Bluetooth, NFC, IR, USB or a
         network connection, and a printer reached through the bambuddy server
         is the last of those. Both this and the Play Console declaration of the
         foreground service type have to keep naming the same one. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <!-- No WAKE_LOCK of ours any more (see `allowWakeLock` in lib/main.dart).
         flutter_foreground_task declares the permission in its own manifest, so
         it still merges into the APK — nothing in this app acquires a lock. -->
    <!-- Battery optimization exemption request: critical for background survival
         on Samsung, and it unblocks starting a foreground service from the
         background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Spool QR scanner (mobile_scanner) — camera on demand only, runtime
         permission requested when the scanner opens. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Self-hosted bambuddy servers on a LAN usually have no TLS; remote access
         should go over HTTPS through a reverse proxy (see README). -->
    <!-- Predictive back (Android 13+): opt in so the system animates the back
         gesture instead of logging "OnBackInvokedCallback is not enabled". Safe
         here because no route intercepts the pop (no PopScope in lib/) — Flutter
         registers the callback itself and keeps handling back as before. -->
    <application
        android:label="Bambuddy"
        android:name="${applicationName}"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task's foreground service — hosts a separate Dart
             isolate that keeps the WebSocket open and posts print notifications
             in the background. Do NOT rename the service (plugin requirement).
             The type is declared here and passed again from
             `ForegroundServiceMonitor`; the two must agree or `startForeground`
             throws on Android 14 and up. stopWithTask=false:
             the service (and with it WS monitoring) survives the app being
             swiped away from recents. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

        <!-- Watch relay on a phone whose app is not running: Play services
             binds a listener service that is declared here and starts the
             process for it (wear/WearRelayListenerService.kt has the why).
             Exported because the binder comes from Play services' own process
             — the callback verifies the sending node rather than the caller.
             No `pathPrefix` on purpose: `watch_connectivity` sends every
             message on a path with no leading slash, so a path filter is a coin
             toss on how Play services builds the URI. This matches any wear
             message (only our own watch install can send one) and the path is
             checked in code. -->
        <service
            android:name=".wear.WearRelayListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" />
            </intent-filter>
        </service>

        <!-- flutter_local_notifications: receiver for taps on notification action
             buttons (e.g. "Mark done" for maintenance). Required by the plugin so
             actions with showsUserInterface=false are handled in the background
             (separate Dart engine) without opening the app. Without this
             declaration Android drops the action broadcast — the handler never
             fires, the notification neither closes nor resets the counter. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- Home screen widget: selected printer status + a filament scan
             shortcut. Pushed by the app (home_widget), not on a period. -->
        <receiver
            android:name=".BambuddyWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bambuddy_widget_info" />
        </receiver>

        <!-- Multi-printer home screen widget: all printers at a glance. Same
             app-pushed update mechanism (home_widget), separate provider/layout. -->
        <receiver
            android:name=".BambuddyMultiWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bambuddy_multi_widget_info" />
        </receiver>

        <!-- WorkManager comes in transitively through androidx.glance (a
             home_widget dependency). We use RemoteViews, NOT Glance, so
             WorkManager isn't needed — and its auto-initialization via
             androidx.startup crashes the WHOLE app on launch in release (R8):
             "Unable to get provider androidx.startup.InitializationProvider …
             Failed to create WorkDatabase". Remove WorkManager's auto-init (keep
             the rest of startup). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- mobile_scanner pulls in ML Kit, which ships Google's datatransport
             backend and periodically POSTs scanner usage telemetry to
             firebaselogging.googleapis.com. Dropping the "cct" backend
             registration leaves the transport runtime with no backend to
             resolve, so those events are discarded locally instead of uploaded.
             The schedulers stay declared on purpose — jobs are scheduled before
             the backend lookup, and removing their services would crash it.
             Barcode scanning itself runs fully on-device and is unaffected. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
