<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Wiszące powiadomienie o wydruku + alerty w tle (Android 13+ wymaga
         uprawnienia runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Foreground service trzyma proces przy życiu w tle, by WebSocket dalej
         dostawał statusy i aktualizował powiadomienie podczas wydruku. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- flutter_foreground_task trzyma wakelock, by isolate tła (WebSocket) nie
         usnął razem z CPU podczas Doze. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Prośba o zwolnienie z optymalizacji baterii: na Samsungu kluczowe dla
         przeżywalności w tle i odblokowuje start foreground service z tła. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Skaner kodów QR szpul (mobile_scanner) — aparat tylko na żądanie,
         uprawnienie runtime proszone przy otwarciu skanera. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Self-hosted serwery bambuddy w LAN zwykle nie mają TLS; dostęp zdalny
         powinien iść przez HTTPS na reverse proxy (patrz README). -->
    <application
        android:label="Bambuddy"
        android:name="${applicationName}"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Foreground service flutter_foreground_task — hostuje osobny isolate
             Dart, który w tle trzyma WebSocket i wystawia powiadomienia o
             wydruku. NIE zmieniać nazwy serwisu (wymóg pluginu). Typ dataSync
             wymagany od Androida 14. stopWithTask=false: serwis (a z nim
             monitoring WS) przeżywa zmiecenie aplikacji z listy ostatnich. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!-- flutter_local_notifications: odbiornik tapnięć przycisków akcji
             powiadomień (np. „Oznacz wykonane" przy konserwacji). Wymagany przez
             plugin, by akcje z showsUserInterface=false były obsłużone w tle
             (osobny silnik Dart) bez otwierania apki. Bez tej deklaracji Android
             gubi broadcast akcji — handler nigdy nie odpala, powiadomienie się
             nie zamyka ani nie resetuje licznika. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- Widget ekranu głównego: status wybranej drukarki + skrót do skanera
             szpuli. Aktualizowany przez apkę (home_widget), nie cyklicznie. -->
        <receiver
            android:name=".BambuddyWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bambuddy_widget_info" />
        </receiver>

        <!-- WorkManager wchodzi tranzytywnie przez androidx.glance (zależność
             home_widget). Używamy RemoteViews, NIE Glance, więc WorkManager nie
             jest potrzebny — a jego auto-inicjalizacja przez androidx.startup
             wywala CAŁĄ apkę na starcie w release (R8): „Unable to get provider
             androidx.startup.InitializationProvider … Failed to create
             WorkDatabase". Usuwamy auto-init WorkManagera (resztę startup zostawiamy). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
