<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Marks this APK as a Wear OS app. Merged only into the `wear` flavor, so
         Google Play offers it as the watch install under the shared listing
         (same applicationId as the phone), and keeps it off phones/tablets. -->
    <uses-feature android:name="android.hardware.type.watch" android:required="true" />

    <!-- Strip phone-only permissions the wear Dart entry point never uses.
         Play gates several of them behind extra review (foreground service
         declaration + video, battery-optimization exemption), so declaring
         them in an APK that can't exercise them only invites rejection. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <!-- The watch has no gallery screen and starts at API 30 anyway. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <!-- The watch never posts its own notifications (Wear OS bridges the
         phone's), so neither the runtime permission nor the reboot
         rescheduling hook (flutter_local_notifications) applies here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <application
        android:enableOnBackInvokedCallback="false"
        tools:replace="android:enableOnBackInvokedCallback">
        <!-- Keep the watch on the legacy back path. The phone manifest opts into
             predictive back, but on Wear OS the back gesture is swipe-to-dismiss
             and the system-driven dismiss animation is not verified against it —
             don't change watch navigation as a side effect of a phone fix. -->

        <!-- Hard-lock the watch UI upright. Must be "nosensor", not "portrait":
             the display is square (450x450), so portrait and landscape share
             dimensions and the system still rotates the whole display 90° when
             the watch is physically turned (verified: requestedOrientation was
             PORTRAIT yet display went to ROTATION_90). "nosensor" tells the
             system to ignore the sensor and keep the natural orientation.
             Merges the attribute onto the shared MainActivity for this flavor
             only — the phone manifest declares no orientation, so no conflict. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="nosensor"
            android:theme="@style/WearLaunchTheme"
            tools:replace="android:theme"
            tools:node="merge">
            <!-- What Flutter puts behind its UI once the engine takes over, and
                 the same style `WearLaunchTheme` names as `postSplashScreenTheme`
                 — the two must agree, because Flutter swaps the window itself in
                 `onCreate` whatever the splash library was told. The phone's
                 LaunchTheme/NormalTheme pair is white in the day variant and
                 carries no icon at all, so the watch gets its own pair rather
                 than an override of theirs — see res/values/styles.xml. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/WearNormalTheme"
                tools:replace="android:resource" />
        </activity>

        <!-- Required by Play for Wear OS distribution: the watch app is fully
             usable without the phone app installed (direct REST fallback). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Phone-only components: home-screen widget, the FGS host for the
             background monitor, the notification-action receiver, and the
             listener service that wakes the phone app for the watch. The wear
             entry point never starts them — drop them from the watch APK. (The
             relay has no watch-side counterpart to declare: the watch app is
             the one that asks, and it is on screen while it waits.) -->
        <receiver android:name=".BambuddyWidgetProvider" tools:node="remove" />
        <receiver android:name=".BambuddyMultiWidgetProvider" tools:node="remove" />
        <service android:name=".wear.WearRelayListenerService" tools:node="remove" />
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            tools:node="remove" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            tools:node="remove" />

        <!-- ML Kit's initializer is a ContentProvider, so Android runs it inside
             `Application.onCreate` on every cold start — component discovery via
             PackageManager plus reflective construction of the barcode and
             vision registrars — before Flutter has been asked to start. The
             watch has no scanner screen to reach it.

             Measured on the wear_round AVD, `am start -W`, seven runs a side:
             dropping this and the two FileProviders below took the median from
             1342 ms to 1259 ms. That is a debug build on desktop cores; the
             share of it is what transfers, not the number.

             The AndroidManifest entries are the whole of the available win —
             the Gradle dependency has to stay, because mobile_scanner's Kotlin
             references these classes and the phone flavor compiles the same
             source set. -->
        <provider
            android:name="com.google.mlkit.common.internal.MlKitInitProvider"
            tools:node="remove" />
        <service
            android:name="com.google.mlkit.common.internal.MlKitComponentDiscoveryService"
            tools:node="remove" />

        <!-- Two more providers instantiated at process start for features the
             watch has no screen for: printing a spool label and sharing a file
             out of the archive. Each parses its own `file_paths` XML on the way
             up. -->
        <provider
            android:name="net.nfet.flutter.printing.PrintFileProvider"
            tools:node="remove" />
        <provider
            android:name="dev.fluttercommunity.plus.share.ShareFileProvider"
            tools:node="remove" />

        <!-- Declared rather than started, so these cost a bigger component table
             rather than startup time — but nothing on the watch can reach any of
             them either. Glance arrives through home_widget (we draw the widgets
             with RemoteViews, not Glance), WorkManager and Room arrive behind
             Glance, CameraX behind mobile_scanner, and the datatransport
             scheduler behind ML Kit. -->
        <receiver
            android:name="androidx.glance.appwidget.action.ActionCallbackBroadcastReceiver"
            tools:node="remove" />
        <receiver
            android:name="androidx.glance.appwidget.MyPackageReplacedReceiver"
            tools:node="remove" />
        <service
            android:name="androidx.glance.appwidget.GlanceRemoteViewsService"
            tools:node="remove" />
        <activity
            android:name="androidx.glance.appwidget.action.ActionTrampolineActivity"
            tools:node="remove" />
        <activity
            android:name="androidx.glance.appwidget.action.InvisibleActionTrampolineActivity"
            tools:node="remove" />
        <service
            android:name="androidx.core.widget.RemoteViewsCompatService"
            tools:node="remove" />
        <service
            android:name="androidx.camera.core.impl.MetadataHolderService"
            tools:node="remove" />

        <!-- flutter_foreground_task's restart hooks. The watch strips the
             service itself above, so these two receivers are wired to nothing;
             RECEIVE_BOOT_COMPLETED is already removed, which leaves RebootReceiver
             unable to fire at all. -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RestartReceiver"
            tools:node="remove" />
    </application>
</manifest>
