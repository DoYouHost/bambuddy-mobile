<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Branded launch, Play's Wear quality check WO-V15: the app icon on black
         until Flutter's first frame. Wear OS 3 (API 30) has no system splash, so
         the icon comes from core-splashscreen, which backports the attributes
         below and maps them onto the platform ones on API 31+ — hence no
         `android:` prefix on them, and hence `installSplashScreen()` before
         `super.onCreate` (BrandedLaunch.kt). A launcher theme of our own is what
         Play saw as "no icon" in version code 1002026020. -->
    <style name="WearLaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wear_splash_icon</item>
        <item name="postSplashScreenTheme">@style/WearNormalTheme</item>
    </style>

    <!-- Behind the Flutter UI once the engine has taken over. Spelled out as
         black rather than `?android:colorBackground` (what the phone uses):
         that resolves to white on a watch set to the light system theme, which
         flashes between the splash and the app's own black face. -->
    <style name="WearNormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
